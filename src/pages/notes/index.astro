---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Notes" section="Project name" description="Every note, newest first.">
  <section class="page">
    <h1>Notes</h1>
    <ul class="cards">
      {notes.map((n) => (
        <li><a href={url(`notes/${n.id}/`)}><strong>{n.data.title}</strong><span>{n.data.description}</span></a>
          <time datetime={n.data.date.toISOString().slice(0, 10)} translate="no">{n.data.date.toISOString().slice(0, 10)}</time></li>
      ))}
    </ul>
  </section>
</Base>
